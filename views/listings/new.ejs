<% layout("/layout/boilerplate")%>
<div class="row">
    <div class="col-8 offset-2">
    <h1> Create a new list</h1>
    <form method="post" action="/listing" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
        <label for="title">Title</label>
        <input type="text" placeholder="Add a Title" name="list[title]" class="form-control" required>
        <div class="valid-feedback">
       Looks good!
    </div>
        </div>
        <div class="mb-3">
         <label for="title">Description</label>
        <textarea type="text" placeholder="enter the description" name="list[description]" class="form-control" required></textarea>
        <div class="invalid-feedback">
       please enter the short description
      </div>
        </div>
        <div class="mb-3">
        <label for="title">Image</label>
        <input type="file" placeholder="URL/LINK" name="list[image][url]" class="form-control" >
         required
        </div>
        <div class="row">
      <div class="mb-3 col-md-4">
        <label for="title">Price</label>
        <input type="number" name="list[price]" class="form-control" placeholder="1200" required>
           <div class="invalid-feedback">
            please enter the price
             </div>
      </div>
      <div class="mb-3 col-md-8">
         <label for="title">Country</label>
      <input type="text" placeholder="India" name="list[country]" class="form-control" required>
      <div class="invalid-feedback">
       please enter the valid country name
    </div>
     </div>
     </div>
      <div class="mb-3">  
          <label for="title">Location</label>
      <input type="text" placeholder="Rajasthan,jaipur" name="list[location]" class="form-control" required>
       <div class="invalid-feedback">
       please enter the valid location
    </div>
      </div>
      <br>
        <button class="btn btn-dark add-btn"> Add</button>
    </form>
    <br><br>
    </div>
    </div>
