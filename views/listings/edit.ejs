<% layout("/layout/boilerplate")%>
<div class="row">
<div class="col-8 offset-2">
<body>
    <h3>Edit your listing</h3>
    <form method="post" action="/listing/<%=list._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">    
            <label for="title">Title</label>  
              <input name="list[title]" value="<%=list.title%>" type="text" class="form-control" required>
              <div class="valid-feedback">
                 Title looks good
              </div>
        </div>
        <div class="mb-3">
            <label for="description">Description</label>
        <textarea name="list[description]" class="form-control" type="text" required ><%=list.description%></textarea>
           <div class="invalid-feedback">
                please enter the short description
           </div>
        </div>
        <div class="mb-3">
            Original Image<br>
           <img src="<%= originalImageUrl %>">
        </div>
        <div class="mb-3">
            <label for="image">Upload Image</label>
         <input type="file" name="list[image][url]" class="form-control" >
         </div>
        <div class="row">
        <div class="mb-3 col-md-4">
            <label for="price">Price</label>
            <input type="number" name="list[price]" class="form-control"   vlaue="<%=list.price%>" required>
            <div class="invalid-feedback">
             please enter the valid location
             </div>

        </div>
        <div class="mb-3 col-md-8">
         <label for="country">Country</label>
          <input type="text" name="list[country]" value="<%=list.country%>" class="form-control" required>
          <div class="invalid-feedback">
               please enter the valid country name
            </div>

        </div>
        </div>
           <div class="mb-3">
            <label for="location">Location</label>
         <input type="text" name="list[location]" class="form-control" value="<%=list.location%>" required>
          <div class="invalid-feedback">
          please enter the price
            </div>
             </div>
           
        <button class="btn btn-dark add-btn mt-3 mb-2">Edit</button>

    </form>
    
</body>
</div>
</div>


